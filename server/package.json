{
  "name": "inventory-sales-server",
  "version": "1.0.0",
  "description": "Enterprise Inventory & Sales Management Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "migrate": "knex migrate:latest --knexfile ./src/config/knexfile.js",
    "seed": "knex seed:run --knexfile ./src/config/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile ./src/config/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile ./src/config/knexfile.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "knex": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.4",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}